# Copy to .env and fill in to enable e-mailing quotations straight from the app.
# For Gmail you must use an App Password (Google Account > Security > App passwords),
# not your normal login password.
QUOTEAPP_SMTP_HOST=smtp.gmail.com
QUOTEAPP_SMTP_PORT=587
QUOTEAPP_SMTP_USER=your.address@gmail.com
QUOTEAPP_SMTP_PASS=your-16-char-app-password
QUOTEAPP_SMTP_FROM=your.address@gmail.com

# Port the web app listens on
PORT=5000
